# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myapp_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_SSL_MODE=disable

# Goose Database Migrations
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:your_secure_db_password@localhost:5432/myapp_db?sslmode=disable
GOOSE_MIGRATION_DIR=./migrations

# Server Configuration
SERVER_PORT=8080
SERVER_MODE=debug
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT Configuration
# CRITICAL:
#  - Never commit real secret keys to version control.
#  - Use strong, randomly generated strings for production secrets.
#  - Keep access and refresh secrets distinct.
# Generate using: openssl rand -base64 32
JWT_SECRET=your_fallback_jwt_secret_key_change_me
JWT_ACCESS_TOKEN_SECRET=your_access_token_secret_key_change_me
JWT_REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_change_me
JWT_ACCESS_TOKEN_EXPIRY_HOURS=1
JWT_REFRESH_TOKEN_EXPIRY_HOURS=168
JWT_EXPIRY_HOURS=24

# Refresh Token Settings
# Useful for token invalidation or persistent logins via POST requests
# REFRESH_TOKEN_EXPIRY_DAYS=7

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# API Configuration
API_PREFIX=/api/v1

# External Integrations & Secrets
# Used for encrypting API keys or outbound webhooks.
# Generate using: openssl rand -hex 16
# API_KEY_SECRET=your_api_key_secret_here

# Outbound Email (SMTP)
# Used when sending transactional emails from the server to clients (PLAIN authentication).
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@example.com

# Public URLs
# APP_BASE_URL=http://localhost:8080

# Testing & Development Flags
# Bypasses rate limiting during manual or automated testing environments.
DISABLE_RATE_LIMIT=false